<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<fmt:requestEncoding value="UTF-8" />
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'Trabajos de Grado - UTS'}" /></title>
    <!-- Bootstrap 5.3 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Estilos UTS -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css?v=20261020_oryzo_green">
    <style>
        /* =============================================================
           ORYZO AI + UTS GREEN PRIORITIZED THEME
           ============================================================= */
        :root {
            --color-warm-cream: #ffedd7;
            --color-cream-muted: #d4c5b3;
            --color-void-dark: #0b140e;
            --color-surface-elevated: #132219;
            --color-surface-hover: #192c20;
            --color-uts-green: #006633;
            --color-uts-green-light: #008744;
            --color-uts-green-dark: #004d26;
            --color-border-cork: #233b2c;
            --color-border-driftwood: #3a5c47;
        }

        body, html {
            background-color: #0b140e !important;
            color: #ffedd7 !important;
        }

        main {
            background-color: #0b140e !important;
        }

        /* BARRA SUPERIOR (NAVBAR) - VERDE INSTITUCIONAL Y LETRAS WARM CREAM */
        .navbar-uts, nav.navbar.navbar-uts {
            background: #006633 !important;
            background: linear-gradient(135deg, #006633 0%, #004d26 100%) !important;
            border-bottom: 1px dashed #233b2c !important;
            box-shadow: none !important;
        }
        .navbar-uts .navbar-brand-title,
        .navbar-uts .navbar-nav .nav-link,
        .navbar-uts .navbar-nav .nav-link i,
        .navbar-uts .nav-link,
        .navbar-uts .text-white,
        .navbar-uts .text-dark,
        .navbar-uts span,
        .navbar-uts div,
        .navbar-uts a {
            color: #ffedd7 !important;
            text-transform: uppercase;
            font-weight: 500;
            letter-spacing: 0.05em;
        }
        .navbar-uts .navbar-brand-subtitle,
        .navbar-uts .text-white-50,
        .navbar-uts .text-secondary {
            color: rgba(255, 237, 215, 0.75) !important;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .navbar-uts .navbar-nav .nav-link:hover {
            background-color: rgba(255, 237, 215, 0.12) !important;
            color: #ffedd7 !important;
        }
        .navbar-uts .navbar-nav .nav-link.active {
            border-bottom: 2px dashed #ffedd7 !important;
            border-radius: 0 !important;
            background: transparent !important;
            color: #ffedd7 !important;
            font-weight: 600 !important;
        }
        .navbar-uts .btn-outline-light {
            border: 1px solid #ffedd7 !important;
            color: #ffedd7 !important;
            background: transparent !important;
            border-radius: 22.5px !important;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .navbar-uts .btn-outline-light:hover {
            background-color: rgba(255, 237, 215, 0.2) !important;
            color: #ffedd7 !important;
        }

        /* BARRA INFERIOR (FOOTER) - VERDE INSTITUCIONAL Y LETRAS WARM CREAM */
        footer.footer-uts, .footer-uts {
            background: #004d26 !important;
            background: linear-gradient(135deg, #004d26 0%, #006633 100%) !important;
            border-top: 1px dashed #233b2c !important;
            color: #ffedd7 !important;
            padding: 2.5rem 0 !important;
            margin-top: 4rem !important;
        }
        footer.footer-uts strong,
        footer.footer-uts small,
        footer.footer-uts p,
        footer.footer-uts a,
        footer.footer-uts i,
        footer.footer-uts span:not(.badge),
        .footer-uts strong,
        .footer-uts small,
        .footer-uts p,
        .footer-uts a,
        .footer-uts i,
        .footer-uts span:not(.badge) {
            color: #ffedd7 !important;
        }
        footer.footer-uts small, .footer-uts small {
            color: rgba(255, 237, 215, 0.75) !important;
        }

        /* TARJETAS Y CONTENEDORES - 12px DE RADIO, SIN SOMBRAS */
        .card, .card-uts {
            background-color: #132219 !important;
            border: 1px solid #233b2c !important;
            border-radius: 12px !important;
            box-shadow: none !important;
            color: #ffedd7 !important;
        }
        .card-header, .card-uts .card-header {
            background-color: transparent !important;
            border-bottom: 1px dashed #233b2c !important;
            color: #ffedd7 !important;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* BOTÓN PRIMARIO - PÍLDORA VERDE UTS DE 36px */
        .btn-uts-primary, .btn-primary {
            background-color: #006633 !important;
            border: 1px solid #008744 !important;
            color: #ffedd7 !important;
            border-radius: 36px !important;
            text-transform: uppercase;
            font-weight: 500;
            letter-spacing: 0.05em;
        }
        .btn-uts-primary:hover, .btn-primary:hover {
            background-color: #008744 !important;
            color: #ffffff !important;
        }

        /* INPUTS - SUBRAYADO MINIMAL (0px RADIUS) */
        .form-control, .form-select {
            background-color: transparent !important;
            color: #ffedd7 !important;
            border: none !important;
            border-bottom: 1px solid #3a5c47 !important;
            border-radius: 0px !important;
        }
        .form-control:focus, .form-select:focus {
            background-color: transparent !important;
            color: #ffedd7 !important;
            border-bottom: 1px solid #ffedd7 !important;
            box-shadow: none !important;
            outline: none !important;
        }
        .form-label {
            color: #ffedd7 !important;
            text-transform: uppercase;
            font-weight: 500;
            font-size: 0.76rem;
            letter-spacing: 0.06em;
        }
    </style>
</head>
<body>
<main>
